# Start with "mock" so your demo always works even if the sandbox is flaky.
# Switch to "live" once your Nokia API key is confirmed working.
CAMARA_MODE=mock

# Nokia Network as Code (from Console > Applications > default-application > API key)
NOKIA_RAPIDAPI_KEY=6da59a5943msh71fe7be85dfbd4ep1b42d3jsn0aff48798a90
NOKIA_RAPIDAPI_HOST=network-as-code.nokia.rapidapi.com
NOKIA_BASE_URL=https://network-as-code.p-eu.apihub.nokia.io

# Used by the Guidance Agent to generate calm, localized directions
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Risk Agent tuning
RISK_THRESHOLD=70
